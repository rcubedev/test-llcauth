generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled connection (for serverless functions)
  directUrl = env("DIRECT_URL")     // direct connection (for migrations)
}

enum Role {
  ADMIN
  STAFF
  PARTICIPANT
}

model RateLimitEvent {
  id        String   @id @default(uuid())
  ip        String
  type      String   // e.g. "send_code", "verify_attempt", "invite_fail"
  createdAt DateTime @default(now())

  @@index([ip, type, createdAt])
  @@map("rate_limit_events")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String?
  lastName  String?
  role      Role     @default(PARTICIPANT)
  createdAt DateTime @default(now())

  codes   VerificationCode[]
  invites InviteRedemption[]

  @@map("users")
}

model VerificationCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_codes")
}

// A shared invite link, e.g. ?invite=mentors-2026. Delete the row to burn it.
// People who already joined keep their role (it lives on the user).
model InviteLink {
  id        String   @id @default(uuid())
  code      String   @unique // stored lowercase
  role      Role     @default(STAFF)
  maxUses   Int?     // null = unlimited
  uses      Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  redemptions InviteRedemption[]

  @@map("invite_links")
}

// One row per person per link, so logging in twice never uses a second slot.
model InviteRedemption {
  inviteId   String
  userId     String
  redeemedAt DateTime @default(now())

  invite InviteLink @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([inviteId, userId])
  @@map("invite_redemptions")
}